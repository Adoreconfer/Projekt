<Window x:Class="Library.Forms.UserMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="Menu" Height="400" Width="450" WindowStartupLocation="CenterScreen" Icon="/Forms/book.png">
    <Grid Margin="20">
        <Grid VerticalAlignment="Top">
            <Label x:Name="welcomeText" Content="Welcome, " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button Content="Log out" Width="75" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Button_Click"/>
        </Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="180">
            <Button Content="Book catalog" Height="35" Margin="0,0,0,12" Click="BookCatalog"/>

            <Button x:Name="bookLoanBtn" Content="Book loans" Height="35" Margin="0,0,0,12" Click="bookLoanBtn_Click"/>

            <Button x:Name="changePasswordBtn" Content="Change password" Height="35" Click="changePasswordBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
