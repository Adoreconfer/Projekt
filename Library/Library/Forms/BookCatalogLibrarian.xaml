<Window x:Class="Library.Forms.BookCatalogLibrarian"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="Catalog" Height="600" Width="683" Icon="/Forms/book.png">
    <Grid>
        <DataGrid x:Name="BooksGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Margin="0,113,0,112">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />

                <DataGridTextColumn Header="Author" Width="1.5*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Author.FirstName" />
                            <Binding Path="Author.LastName" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120" />
                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="120" />

                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="120" />

                <DataGridTextColumn Header="Total" Binding="{Binding TotalCopies}" Width="60" />
                <DataGridTextColumn Header="Available" Binding="{Binding AvailableCopies}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Back" HorizontalAlignment="Left" Margin="37,526,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="Button_Click"/>
        <TextBox x:Name="searchBox" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="314" Height="28" FontSize="19"/>
        <RadioButton x:Name="allRadio" GroupName="Type" Content="All" HorizontalAlignment="Left" Margin="24,65,0,0" VerticalAlignment="Top" IsChecked="True"/>
        <RadioButton x:Name="TitleRadio" GroupName="Type" Content="Title" HorizontalAlignment="Left" Margin="102,65,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="AuthorRadio" GroupName="Type" Content="Author" HorizontalAlignment="Left" Margin="182,65,0,0" VerticalAlignment="Top"/>
        <Button x:Name="searchBtn" Content="Search" HorizontalAlignment="Left" Margin="342,10,0,0" VerticalAlignment="Top" Height="28" Width="68" Click="searchBtn_Click"/>
        <ComboBox x:Name="classComboBox" HorizontalAlignment="Left" Margin="481,58,0,0" VerticalAlignment="Top" Width="120"/>
        <Label Content="Category" HorizontalAlignment="Left" Margin="512,24,0,0" VerticalAlignment="Top"/>
        <Button x:Name="addBtn_Copy" Content="Add book" HorizontalAlignment="Left" Margin="277,526,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="addBtn_Click"/>
        <Button x:Name="editBtn_Copy" Content="Edit book" HorizontalAlignment="Left" Margin="401,526,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="editBtn_Click"/>
        <Button x:Name="deleteBtn_Copy" Content="Delete book" HorizontalAlignment="Left" Margin="519,526,0,0" VerticalAlignment="Top" Height="27" Width="82" Click="deleteBtn_Click"/>
    </Grid>
</Window>
