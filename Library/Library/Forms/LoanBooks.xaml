<Window x:Class="Library.Forms.LoanBooks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="LoanBooks" Height="450" Width="650" WindowStartupLocation="CenterScreen" Icon="/Forms/book.png">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="LoansGrid" 
                  Grid.Row="0" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  Background="White" 
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding IdLoan}" Width="50"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Book.Title}" Width="*"/>

                <DataGridTextColumn Header="Author" Width="1.5*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat='{}{0} {1}'>
                            <Binding Path="Book.Author.FirstName" />
                            <Binding Path="Book.Author.LastName" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn Header="ISBN" Binding="{Binding Book.ISBN}" Width="110"/>
                <DataGridTextColumn Header="Loan date" Binding="{Binding LoanDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="95"/>
                <DataGridTextColumn Header="Due date" Binding="{Binding DueDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="95"/>
                <DataGridTextColumn Header="Return date" Binding="{Binding ReturnDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="95"/>
                <DataGridTextColumn Header="Fine" Binding="{Binding Fine, StringFormat={}{0} PLN}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="backBtn" 
                Grid.Row="1" 
                Content="Back" 
                Width="90" 
                Height="30" 
                HorizontalAlignment="Left" 
                Click="backBtn_Click"/>
    </Grid>
</Window>
