<Window x:Class="Library.Forms.ManageBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="Manage Book" Height="420" Width="480" WindowStartupLocation="CenterScreen" Icon="/Forms/book.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Title" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="titleBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="26" VerticalContentAlignment="Center" Margin="0,5,20,5"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Author" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="authorBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="26" VerticalContentAlignment="Center" Margin="0,5,20,5"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Category" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="categoryBox" Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,5,0,5"/>
            <ComboBox x:Name="categoryComboBox" Grid.Row="2" Grid.Column="2" Height="26" VerticalContentAlignment="Center" Margin="10,5,20,5"/>

            <Label Grid.Row="3" Grid.Column="0" Content="ISBN" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="isbnBox" Grid.Row="3" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,5,0,5"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Publication year" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="yearBox" Grid.Row="4" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,5,0,5"/>

            <Label Grid.Row="5" Grid.Column="0" Content="Total copies" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="copiesBox" Grid.Row="5" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Margin="0,5,0,5"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="manageBtn" Grid.Column="0" Content="Manage button" Width="110" Height="30" Click="manageBtn_Click"/>
            <Button x:Name="backBtn" Grid.Column="2" Content="Back" Width="85" Height="30" Click="backBtn_Click"/>
        </Grid>
    </Grid>
</Window>
