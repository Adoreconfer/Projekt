<Window x:Class="Library.Forms.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="Register" Height="300" Width="450" Icon="/Forms/reg.png">
    <Grid>
        <Label Content="Username" HorizontalAlignment="Left" Margin="97,112,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Left"/>
        <Label Content="First name" HorizontalAlignment="Left" Margin="96,48,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Left"/>
        <Label Content="Last name" HorizontalAlignment="Left" Margin="97,80,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Left" RenderTransformOrigin="0.373,0.502"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="99,142,0,0" VerticalAlignment="Top" HorizontalContentAlignment="Left"/>
        <TextBox x:Name="firstnameBox" HorizontalAlignment="Center" Margin="0,52,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="lastnameBox" HorizontalAlignment="Center" Margin="0,84,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="usernameBox" HorizontalAlignment="Center" Margin="0,116,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <PasswordBox x:Name="passwordBox" HorizontalAlignment="Center" Margin="0,146,0,0" VerticalAlignment="Top" Width="120"/>
        <Button Content="Back" HorizontalAlignment="Left" Margin="345,241,0,0" VerticalAlignment="Top" Width="61" Click="Button_Click_1"/>
        <Button Content="Register" HorizontalAlignment="Center" Margin="0,192,0,0" VerticalAlignment="Top" Width="62" Click="Button_Click"/>

    </Grid>
</Window>
