<Window x:Class="Library.Forms.BookCatalog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Forms"
        mc:Ignorable="d"
        Title="Catalog" Height="600" Width="700" WindowStartupLocation="CenterScreen" Icon="/Forms/book.png">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="searchBox" Width="280" Height="28" FontSize="16" VerticalContentAlignment="Center"/>
                <Button x:Name="searchBtn" Content="Search" Width="75" Height="28" Margin="8,0,0,0" Click="searchBtn_Click"/>

                <Label Content="Category:" VerticalAlignment="Center" Margin="25,0,5,0"/>
                <ComboBox x:Name="classComboBox" Width="130" Height="28" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                <Label Content="Search by:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" Foreground="Gray"/>
                <RadioButton x:Name="allRadio" GroupName="Type" Content="All" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <RadioButton x:Name="TitleRadio" GroupName="Type" Content="Title" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <RadioButton x:Name="AuthorRadio" GroupName="Type" Content="Author" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <DataGrid x:Name="BooksGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Author" Width="1.5*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat='{}{0} {1}'>
                            <Binding Path="Author.FirstName" />
                            <Binding Path="Author.LastName" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="110" />
                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="65" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="110" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalCopies}" Width="55" />
                <DataGridTextColumn Header="Available" Binding="{Binding AvailableCopies}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Back" Grid.Column="0" Width="85" Height="30" Click="Button_Click"/>
            <Button x:Name="loanBtn" Content="Loan book" Grid.Column="2" Width="95" Height="30" Click="loanBtn_Click"/>
        </Grid>

    </Grid>
</Window>
